#!/usr/bin/env bash
# hpc: command-line helpers for the UniCal HPC cluster, run from your own machine over SSH.
# Requires the university OpenVPN connection and HPC_USER (your cluster login).
set -euo pipefail

HOST=hpcgate.unical.it

# Load HPC_USER from <repo>/.env unless it is already set. The repo is located by
# following symlinks, so the command works from any directory once linked on PATH.
src=${BASH_SOURCE[0]}
while [[ -L $src ]]; do
  dir=$(cd "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  [[ $src == /* ]] || src=$dir/$src
done
ROOT=$(cd "$(dirname "$src")/.." && pwd)
ENV_FILE=$ROOT/.env
if [[ -z ${HPC_USER:-} && -f $ENV_FILE ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi
: "${HPC_USER:?set HPC_USER in $ENV_FILE or in the environment}"
TARGET="$HPC_USER@$HOST"
# The current local directory maps to ~/projects/<its name> on the cluster.
REMOTE_DIR="projects/$(basename "$PWD")"

die() { echo "hpc: $*" >&2; exit 1; }

# A job ID, or a task of a job array as ID_TASK.
JOB_ID='^[0-9]+(_[0-9]+)?$'

# Commands share one SSH connection, kept for 10 minutes after the last one, so that only the
# first pays for connecting.
SHARED=(-o ControlMaster=auto -o "ControlPath=~/.ssh/hpc-%C" -o ControlPersist=600
        -o ServerAliveInterval=10 -o ServerAliveCountMax=2)

# Run a command line on the head node. Set TTY=1 to allocate a terminal (needed to interrupt a
# remote `tail -f`); a terminal session gets a connection of its own, because inside the shared
# one it can freeze it, and with it every later command.
on_cluster() {
  if [[ -n ${TTY:-} ]]; then
    ssh -o ControlPath=none -t "$TARGET" "$1"
  else
    ssh "${SHARED[@]}" "$TARGET" "$1"
  fi
}

# Run a command on the head node with Slurm loaded. No login shell: it would run the user's
# profile a second time, which costs about one second per command.
remote() { on_cluster "module load slurm && $1"; }

# The same in a login shell, for what starts a job: the job inherits that environment (Conda included).
remote_login() {
  local cmd="module load slurm && $1" quote="'" escaped="'\\''"
  on_cluster "bash -lc '${cmd//$quote/$escaped}'"
}

# Quote arguments for the remote shell.
quote_args() { printf '%q ' "$@"; }

# Class presets from the cluster guide: MIG profile, default CPU cores and RAM.
preset() {
  case $1 in
    tiny)   PROFILE=1g.35gb;  CPUS=2;  MEM=32G ;;
    small)  PROFILE=2g.35gb;  CPUS=3;  MEM=64G ;;
    medium) PROFILE=4g.71gb;  CPUS=6;  MEM=128G ;;
    large)  PROFILE=7g.141gb; CPUS=11; MEM=240G ;;
    cpu)    PROFILE='';       CPUS=1;  MEM=16G ;;
    *) die "unknown class '$1' (tiny|small|medium|large|cpu)" ;;
  esac
}

# Parse CLASS and the options shared by submit and shell.
# Sets ARGS (Slurm options), REQUEUE, PUSH, REST (positional arguments) and EXTRA (options after "--").
resources() {
  local class=$1 time='' booked=0 free=0
  shift
  preset "$class"
  REQUEUE=0 PUSH=0 REST=() EXTRA=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --time)    time=${2:?--time needs a value}; shift 2 ;;
      --cpus)    CPUS=${2:?--cpus needs a value}; shift 2 ;;
      --mem)     MEM=${2:?--mem needs a value}; shift 2 ;;
      --booked)  booked=1; shift ;;
      --requeue) REQUEUE=1; shift ;;
      --push)    PUSH=1; shift ;;
      --free)    free=1; shift ;;
      # Everything after "--" goes to Slurm as is, after the presets, so it wins over them.
      --)        shift; EXTRA=("$@"); break ;;
      -*)        die "unknown option $1" ;;
      *)         REST+=("$1"); shift ;;
    esac
  done
  [[ -n $time ]] || die "--time is required"
  # Refuse now rather than queue behind a busy class; the check runs before anything is pushed.
  if [[ $free -eq 1 ]]; then HPC_TARGET=$TARGET uv run --project "$ROOT" hpc-free "$class"; fi

  local qos=scavenger
  if [[ $booked -eq 1 ]]; then
    [[ -n $PROFILE ]] || die "the cpu class has no booking"
    qos=gpu_${class}_reserved
  fi
  ARGS=(--partition=aiq --qos="$qos" --nodes=1 --ntasks=1
        --cpus-per-task="$CPUS" --mem="$MEM" --time="$time")
  if [[ -n $PROFILE ]]; then ARGS+=(--gres="gpu:$PROFILE:1"); fi
}

cmd_submit() {
  [[ $# -ge 1 ]] || die "usage: hpc submit CLASS --time HH:MM:SS [--booked] [--requeue] [--push] [--free] [--cpus N] [--mem SIZE] SCRIPT [-- SBATCH_OPTION...]"
  resources "$@"
  [[ ${#REST[@]} -ge 1 ]] || die "missing SCRIPT"
  [[ ${#REST[@]} -eq 1 ]] || die "only one script allowed"
  if [[ $REQUEUE -eq 1 ]]; then ARGS+=(--requeue); fi
  if [[ $PUSH -eq 1 ]]; then cmd_push; fi
  # ${EXTRA[@]+...}: bash 3.2 treats an empty array as unset under `set -u`.
  remote_login "cd $(printf %q "$REMOTE_DIR") && sbatch $(quote_args "${ARGS[@]}" ${EXTRA[@]+"${EXTRA[@]}"} "${REST[0]}")"
}

# Interactive shell on a compute node, with the same resources as a job of that class.
cmd_shell() {
  [[ $# -ge 1 ]] || die "usage: hpc shell CLASS --time HH:MM:SS [--booked] [--push] [--free] [--cpus N] [--mem SIZE] [-- SRUN_OPTION...]"
  resources "$@"
  [[ $REQUEUE -eq 0 ]] || die "--requeue does not apply to an interactive shell"
  [[ ${#REST[@]} -eq 0 ]] || die "shell takes no script"
  if [[ $PUSH -eq 1 ]]; then cmd_push; fi
  TTY=1 remote_login "cd $(printf %q "$REMOTE_DIR") && srun $(quote_args "${ARGS[@]}" ${EXTRA[@]+"${EXTRA[@]}"})--pty bash -l"
}

# Push, submit, wait and pull in one command; the exit status is that of the job (see wait).
# --pull PATH (repeatable) names what to fetch when the job COMPLETED.
cmd_run() {
  [[ $# -ge 1 ]] || die "usage: hpc run CLASS --time HH:MM:SS [--booked] [--requeue] [--free] [--cpus N] [--mem SIZE] [--pull PATH]... SCRIPT [-- SBATCH_OPTION...]"
  local class=$1 args=() pull=() out
  shift
  while [[ $# -gt 0 ]]; do
    case $1 in
      --pull) pull+=("${2:?--pull needs a value}"); shift 2 ;;
      --)     args+=("$@"); break ;;
      *)      args+=("$1"); shift ;;
    esac
  done
  out=$(cmd_submit "$class" --push ${args[@]+"${args[@]}"})
  echo "$out"
  [[ $out =~ Submitted\ batch\ job\ ([0-9]+) ]] || die "cannot read the job ID from the sbatch output"
  local id=${BASH_REMATCH[1]}
  cmd_wait "$id" || die "job $id did not complete (see: hpc logs $id)"
  if [[ ${#pull[@]} -gt 0 ]]; then cmd_pull "${pull[@]}"; fi
}

# One array task per line of PARAMS: tasks read their line with
# sed -n "${SLURM_ARRAY_TASK_ID}p" "$HPC_SWEEP_FILE". --parallel N caps the tasks running at once.
cmd_sweep() {
  [[ $# -ge 1 ]] || die "usage: hpc sweep CLASS --time HH:MM:SS --params FILE [--parallel N] [--booked] [--requeue] [--free] [--cpus N] [--mem SIZE] SCRIPT [-- SBATCH_OPTION...]"
  local class=$1 args=() extra=() params='' parallel=''
  shift
  while [[ $# -gt 0 ]]; do
    case $1 in
      --params)   params=${2:?--params needs a value}; shift 2 ;;
      --parallel) parallel=${2:?--parallel needs a value}; shift 2 ;;
      --)         shift; extra=("$@"); break ;;
      *)          args+=("$1"); shift ;;
    esac
  done
  [[ -n $params ]] || die "--params is required"
  [[ -s $params ]] || die "parameter file '$params' is missing or empty"
  [[ -z $parallel || $parallel =~ ^[0-9]+$ ]] || die "--parallel needs a number"
  local tasks
  tasks=$(grep -c '' "$params")
  cmd_submit "$class" --push ${args[@]+"${args[@]}"} -- "--array=1-$tasks${parallel:+%$parallel}" \
    "--export=ALL,HPC_SWEEP_FILE=$params" ${extra[@]+"${extra[@]}"}
}

# Running and pending jobs, and the last job of the week, in one line.
cmd_status() {
  remote 'r=$(squeue -u "$USER" -h -t RUNNING | wc -l); p=$(squeue -u "$USER" -h -t PENDING | wc -l); l=$(sacct -X -n -P -u "$USER" -S now-7days --format=JobID,JobName,State,Elapsed | tail -n 1); echo "running $r | pending $p | last: ${l:-none}"'
}

cmd_queue() {
  local query='squeue -u "$USER" -o "%.10i %.24j %.10T %.10M %.24q %R"; sacct -X -S now-1days --format=JobID,JobName,State,Elapsed,ExitCode'
  case ${1:-} in
    '') remote "$query" ;;
    -w)
      local seconds=${2:-10}
      [[ $seconds =~ ^[0-9]+$ ]] || die "usage: hpc queue [-w [SECONDS]]"
      # One SSH session; `watch` on the head node re-runs the query until Ctrl-C.
      TTY=1 remote "watch -n $seconds '$query'"
      ;;
    *) die "usage: hpc queue [-w [SECONDS]]" ;;
  esac
}

# Interactive view of the cluster and of your jobs: the Textual application in hpc_top/, run locally by uv.
cmd_top() {
  HPC_TARGET=$TARGET exec uv run --project "$ROOT" hpc-top
}

# Classes with a free GPU slice right now, per node; reuses the parsers of the interactive view.
cmd_free() {
  HPC_TARGET=$TARGET exec uv run --project "$ROOT" hpc-free
}

# CPU and memory efficiency of a finished job.
cmd_info() {
  [[ ${1:-} =~ $JOB_ID ]] || die "usage: hpc info JOB_ID"
  remote "seff $1"
}

cmd_qos() {
  remote 'sacctmgr -nP show assoc where user="$USER" format=Account,User,QOS,DefaultQOS'
}

cmd_push() {
  on_cluster "mkdir -p $(printf %q "$REMOTE_DIR")"
  rsync -az -e "ssh ${SHARED[*]}" --exclude .git --filter=':- .gitignore' --filter=':- .hpcignore' ./ "$TARGET:$REMOTE_DIR/"
}

cmd_pull() {
  [[ $# -ge 1 ]] || die "usage: hpc pull PATH..."
  local sources=() p
  for p in "$@"; do sources+=("$TARGET:$REMOTE_DIR/./$p"); done
  rsync -azR -e "ssh ${SHARED[*]}" "${sources[@]}" ./
}

cmd_logs() {
  local id='' a
  for a in "$@"; do
    case $a in
      -f) TTY=1 ;;
      *) [[ $a =~ $JOB_ID ]] || die "usage: hpc logs [JOB_ID] [-f]"; id=$a ;;
    esac
  done
  local follow='' pattern='*.out' lookup=''
  if [[ -n ${TTY:-} ]]; then follow=-f; fi
  # Both slurm-%j.out and %x-%j.out put "-" before the ID, so "*-12.out" cannot match job 112.
  if [[ -n $id ]]; then pattern="*-$id.out"; fi
  # %j is the real job ID of an array task, which differs from ID_TASK: ask Slurm for it.
  if [[ $id == *_* ]]; then
    lookup="id=\$(sacct -X -n -P -j $id --format=JobIDRaw | head -n 1); [ -n \"\$id\" ] || { echo 'hpc: job $id not found' >&2; exit 1; }; "
    pattern='*-$id.out'
  fi
  remote "cd $(printf %q "$REMOTE_DIR") && ${lookup}f=\$(ls -t $pattern 2>/dev/null | head -n 1); [ -n \"\$f\" ] || { echo 'hpc: no log found' >&2; exit 1; }; echo \"== \$f\"; tail -n 50 $follow \"\$f\""
}

# Forward localhost:PORT to the same port of NODE, through the head node, until Ctrl-C.
open_tunnel() { # open_tunnel NODE LOCAL_PORT [NODE_PORT]: the node port defaults to the local one
  local remote_port=${3:-$2}
  echo "hpc: localhost:$2 -> $1:$remote_port (Ctrl-C to close)"
  # In the background and waited for: bash runs a trap only after a foreground child ends, so with ssh in the
  # foreground a TERM sent to this process alone would leave the tunnel (and, in serve, the job) running; and
  # a background command ignores SIGINT, hence the explicit kill. serve's EXIT trap then cancels the job.
  ssh -N -o ExitOnForwardFailure=yes -L "$2:$1:$remote_port" "$TARGET" &
  local tunnel=$!
  trap 'kill "$tunnel" 2>/dev/null; exit 130' INT TERM
  wait "$tunnel"
}

# Forward localhost:PORT to the same port of the node that runs the job, until Ctrl-C.
cmd_tunnel() {
  [[ ${1:-} =~ $JOB_ID && ${2:-} =~ ^[0-9]+$ ]] || die "usage: hpc tunnel JOB_ID PORT"
  local node
  node=$(remote "squeue -h -j $1 -o %N") || die "job $1 not found"
  [[ -n $node ]] || die "job $1 is not running on a node"
  open_tunnel "$node" "$2"
}

# Run first in the job of `serve`: the nodes are shared, so a fixed port can already be taken by another
# user. Pick a random port nobody listens on (bash: /bin/sh is bash on the cluster), announce it in the job
# log as HPC_PORT=N, and run the service on it (__PORT__ becomes $HPC_RPORT).
PICK_PORT='until HPC_RPORT=$((20000 + RANDOM % 20000)); ! (exec 3<>/dev/tcp/127.0.0.1/$HPC_RPORT) 2>/dev/null; do :; done; echo HPC_PORT=$HPC_RPORT; '

# Service presets, based on the launcher scripts of Professor Alviano (hpc-jupy.sh, hpc-comfy.sh,
# hpc-ollama.sh): default local port and command (__PORT__ is replaced by the port picked by the job). The tunnel reaches the
# node through the head node, not through the node's loopback, so a server must listen on all interfaces.
# vllm, tensorboard, openwebui, llamacpp and mlflow are not from those scripts: they take an optional or required
# argument ($2) and run from what `hpc setup` installed.
service() {
  local root backend_env
  case $1 in
    jupyter) PORT=8888;  SERVICE='exec jupyter lab --no-browser --ip=0.0.0.0 --port=__PORT__' ;;
    # comfy and ollama are the ones installed by `hpc setup`, called by absolute path.
    comfy)   PORT=8188;  SERVICE="unset VIRTUAL_ENV; export PYTHONNOUSERSITE=1 CONDA_PREFIX=\$HOME/envs/comfy PATH=\$HOME/envs/comfy/bin:\$PATH && comfy-cli set-default ~/comfy/ComfyUI/ --launch-extras='--enable-manager --enable-cors-header --port __PORT__ --listen 0.0.0.0' && exec comfy-cli launch" ;;
    ollama)  PORT=11434; SERVICE='OLLAMA_ORIGINS=http://localhost:*,http://127.0.0.1:* OLLAMA_HOST=0.0.0.0:__PORT__ OLLAMA_VULKAN=1 exec ~/.local/bin/ollama serve' ;;
    vllm)
      [[ -n ${2:-} ]] || die "vllm needs a model: hpc serve CLASS --time T vllm MODEL"
      PORT=8000; SERVICE="unset VIRTUAL_ENV; export PYTHONNOUSERSITE=1 PATH=\$HOME/envs/vllm/bin:\$PATH && exec vllm serve $(printf %q "$2") --host 0.0.0.0 --port __PORT__" ;;
    tensorboard)
      PORT=6006; SERVICE="unset VIRTUAL_ENV; export PYTHONNOUSERSITE=1 PATH=\$HOME/envs/tensorboard/bin:\$PATH && exec tensorboard --logdir $(printf %q "${2:-.}") --host 0.0.0.0 --port __PORT__" ;;
    # Chat UI on CPU in front of another serve job: pass the backend as http://NODE:PORT (ollama) or
    # http://NODE:PORT/v1 (vLLM / OpenAI-compatible). Auth is Open WebUI's own (first account is admin).
    openwebui)
      PORT=8080
      backend_env=''
      if [[ -n ${2:-} ]]; then
        if [[ $2 == */v1 || $2 == */v1/ ]]; then
          backend_env="OPENAI_API_BASE_URL=$(printf %q "${2%/}") OPENAI_API_KEY=\${OPENAI_API_KEY:-sk-none}"
        else
          backend_env="OLLAMA_BASE_URL=$(printf %q "$2")"
        fi
      fi
      SERVICE="unset VIRTUAL_ENV; export PYTHONNOUSERSITE=1 DATA_DIR=\$HOME/.open-webui PATH=\$HOME/envs/openwebui/bin:\$PATH${backend_env:+ $backend_env} && mkdir -p \"\$DATA_DIR\" && exec open-webui serve --host 0.0.0.0 --port __PORT__" ;;
    # GGUF server (lighter than ollama); MODEL is a path on the cluster. -ngl 99 offloads to the GPU when
    # the binary was built with CUDA (see hpc setup llamacpp); a CPU-only binary ignores it.
    llamacpp)
      [[ -n ${2:-} ]] || die "llamacpp needs a GGUF model: hpc serve CLASS --time T llamacpp MODEL"
      PORT=8080; SERVICE="exec ~/.local/bin/llama-server -m $(printf %q "$2") --host 0.0.0.0 --port __PORT__ -ngl 99" ;;
    # Experiment tracking next to tensorboard: store under ~/mlflow (or STORE) so it survives the job.
    mlflow)
      PORT=5000
      if [[ -n ${2:-} ]]; then
        root=$(printf %q "$2")
        SERVICE="unset VIRTUAL_ENV; export PYTHONNOUSERSITE=1 PATH=\$HOME/envs/mlflow/bin:\$PATH && mkdir -p $root/artifacts && exec mlflow server --host 0.0.0.0 --port __PORT__ --backend-store-uri sqlite:///$root/mlflow.db --default-artifact-root $root/artifacts"
      else
        SERVICE="unset VIRTUAL_ENV; export PYTHONNOUSERSITE=1 PATH=\$HOME/envs/mlflow/bin:\$PATH && mkdir -p \"\$HOME/mlflow/artifacts\" && exec mlflow server --host 0.0.0.0 --port __PORT__ --backend-store-uri sqlite:///\$HOME/mlflow/mlflow.db --default-artifact-root \"\$HOME/mlflow/artifacts\""
      fi ;;
    *) die "unknown service '$1' (jupyter|comfy|ollama|vllm|tensorboard|openwebui|llamacpp|mlflow, or --cmd)" ;;
  esac
}

# What `hpc setup` runs on the compute node: for each component named in "$@", check it, and install it
# only if it is missing. It never touches what exists, so it can be run again at any time.
SETUP_SCRIPT=$(cat <<'EOF'
set -u -o pipefail
status=0
ok()   { echo "ok   - $1"; }
fail() { echo "FAIL - $1: $2"; status=1; }
online() { curl -fsI --max-time 15 "$1" >/dev/null 2>&1; }

setup_ollama() {
  local bin=$HOME/.local/bin/ollama
  if [ -x "$bin" ]; then ok "ollama is installed ($bin)"; return; fi
  online https://ollama.com || { fail ollama "this node cannot reach ollama.com"; return; }
  command -v zstd >/dev/null || { fail ollama "zstd is missing on this node"; return; }
  mkdir -p "$HOME/.local"
  if curl -fsSL https://ollama.com/download/ollama-linux-amd64.tar.zst | zstd -d | tar -xf - -C "$HOME/.local" && [ -x "$bin" ]
  then ok "ollama installed in ~/.local"; else fail ollama "download or extraction failed"; fi
}

setup_comfy() {
  local env=$HOME/envs/comfy ws=$HOME/comfy
  # comfy-cli takes its Python from CONDA_PREFIX, which a login shell sets to the conda base; the base cannot
  # be written, so pip falls back to ~/.local and pollutes it. Point CONDA_PREFIX at the environment and hide
  # the user site.
  unset VIRTUAL_ENV
  export CONDA_PREFIX="$env" PATH="$env/bin:$PATH" PYTHONNOUSERSITE=1
  has_torch() { "$env/bin/python" -c 'import torch' >/dev/null 2>&1; }
  if [ -x "$env/bin/comfy-cli" ] && [ -d "$ws/ComfyUI" ] && has_torch; then ok "ComfyUI is installed ($ws/ComfyUI)"; return; fi
  online https://pypi.org && online https://github.com || { fail comfy "this node cannot reach pypi.org or github.com"; return; }
  if [ ! -x "$env/bin/comfy-cli" ]; then
    conda create -y -q -p "$env" python=3.12 && "$env/bin/pip" install -q comfy-cli || { fail comfy "cannot create the environment $env"; return; }
  fi
  [ ! -d "$ws/ComfyUI" ] || { fail comfy "$ws/ComfyUI exists but $env has no PyTorch: move $ws aside and run again"; return; }
  "$env/bin/comfy-cli" --skip-prompt --workspace "$ws/ComfyUI" install --nvidia || { fail comfy "comfy install failed"; return; }
  has_torch || { fail comfy "PyTorch is not in $env after the install"; return; }
  ok "ComfyUI installed in ~/comfy/ComfyUI"
}

# An own conda environment ~/envs/NAME holding the pip package PKG, whose command is NAME.
setup_pip_env() {
  local name=$1 pkg=$2 env=$HOME/envs/$1
  if [ -x "$env/bin/$name" ]; then ok "$name is installed ($env)"; return; fi
  online https://pypi.org || { fail "$name" "this node cannot reach pypi.org"; return; }
  unset VIRTUAL_ENV
  export PYTHONNOUSERSITE=1
  if conda create -y -q -p "$env" python=3.12 && "$env/bin/pip" install -q "$pkg" && [ -x "$env/bin/$name" ]
  then ok "$name installed in $env"; else fail "$name" "cannot create the environment $env"; fi
}
setup_vllm() { setup_pip_env vllm vllm; }
setup_tensorboard() { setup_pip_env tensorboard tensorboard; }
setup_mlflow() { setup_pip_env mlflow mlflow; }

# open-webui installs as the open-webui command (hyphen), in ~/envs/openwebui.
setup_openwebui() {
  local env=$HOME/envs/openwebui
  if [ -x "$env/bin/open-webui" ]; then ok "openwebui is installed ($env)"; return; fi
  online https://pypi.org || { fail openwebui "this node cannot reach pypi.org"; return; }
  unset VIRTUAL_ENV
  export PYTHONNOUSERSITE=1
  if conda create -y -q -p "$env" python=3.12 && "$env/bin/pip" install -q open-webui && [ -x "$env/bin/open-webui" ]
  then ok "openwebui installed in $env"; else fail openwebui "cannot create the environment $env"; fi
}

# llama-server in ~/.local/bin: CUDA build when nvcc and cmake are on the node, else the official
# ubuntu-x64 release (CPU). Pin nothing: take the latest GitHub release tag.
setup_llamacpp() {
  local bin=$HOME/.local/bin/llama-server tag tmp dir
  if [ -x "$bin" ]; then ok "llamacpp is installed ($bin)"; return; fi
  online https://github.com || { fail llamacpp "this node cannot reach github.com"; return; }
  mkdir -p "$HOME/.local/bin"
  tag=$(curl -fsSL https://api.github.com/repos/ggml-org/llama.cpp/releases/latest | sed -n 's/.*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
  [ -n "$tag" ] || { fail llamacpp "cannot read the latest llama.cpp release tag"; return; }
  if command -v nvcc >/dev/null && command -v cmake >/dev/null && command -v git >/dev/null; then
    tmp=$(mktemp -d) || { fail llamacpp "cannot create a temp directory"; return; }
    if git clone --depth 1 --branch "$tag" https://github.com/ggml-org/llama.cpp.git "$tmp/src" \
      && cmake -S "$tmp/src" -B "$tmp/build" -DGGML_CUDA=1 -DCMAKE_BUILD_TYPE=Release \
      && cmake --build "$tmp/build" -j "$(nproc 2>/dev/null || echo 2)" --target llama-server \
      && cp "$tmp/build/bin/llama-server" "$bin" && chmod +x "$bin"
    then ok "llamacpp installed in $bin (CUDA, $tag)"; rm -rf "$tmp"; return
    fi
    rm -rf "$tmp"
    fail llamacpp "CUDA build of $tag failed"; return
  fi
  tmp=$(mktemp -d) || { fail llamacpp "cannot create a temp directory"; return; }
  if curl -fsSL -o "$tmp/llama.tgz" "https://github.com/ggml-org/llama.cpp/releases/download/$tag/llama-$tag-bin-ubuntu-x64.tar.gz" \
    && tar -xzf "$tmp/llama.tgz" -C "$tmp" \
    && dir=$(find "$tmp" -type f -name llama-server | head -n1) && [ -n "$dir" ] \
    && cp "$dir" "$bin" && chmod +x "$bin"
  then ok "llamacpp installed in $bin (CPU, $tag)"; else fail llamacpp "download or extraction of $tag failed"; fi
  rm -rf "$tmp"
}

for target in "$@"; do "setup_$target"; done
exit $status
EOF
)

# Check ollama, ComfyUI, vLLM, TensorBoard, Open WebUI, llama.cpp and MLflow on a compute node and install
# what is missing (the software only, no models). With no argument: ollama and ComfyUI; the others are
# larger or optional, so they are asked for by name.
cmd_setup() {
  local time=01:00:00 targets=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --time)        time=${2:?--time needs a value}; shift 2 ;;
      comfy|ollama|vllm|tensorboard|openwebui|llamacpp|mlflow)  targets+=("$1"); shift ;;
      *)             die "usage: hpc setup [ollama] [comfy] [vllm] [tensorboard] [openwebui] [llamacpp] [mlflow] [--time HH:MM:SS]" ;;
    esac
  done
  [[ ${#targets[@]} -gt 0 ]] || targets=(ollama comfy)
  cpu_node_run "$time" "$SETUP_SCRIPT" hpc-setup "${targets[@]}"
}

# What `hpc cache` runs on a cpu node (bash -c; the arguments are the action, yes|no, and what the action
# needs): measuring the home is slow on this disk (many small files), hence a job and not the head node.
# Deleting is a dry run unless the second argument is yes.
CACHE_SCRIPT=$(cat <<'EOF'
set -u
action=$1 yes=$2; shift 2
home=$HOME
fail() { echo "FAIL - $1"; exit 1; }
size_kb() { du -sk "$1" 2>/dev/null | cut -f1; }
human() { awk -v k="$1" 'BEGIN { split("K M G T", u, " "); i = 1; while (k >= 1024 && i < 4) { k /= 1024; i++ }; f = (i == 1) ? "%d%s" : "%.1f%s"; printf f, k, u[i] }'; }

cache_report() {
  echo "home: $(df -hP "$home" | awk 'NR == 2 {print $3 " used of " $2 ", " $4 " free (a disk shared with other users)"}')"
  local tmp e kb
  tmp=$(mktemp)
  add() { kb=$(size_kb "$2"); [ -z "$kb" ] || printf '%s|%s|%s\n' "$kb" "$1" "$3" >> "$tmp"; return 0; }
  add "ComfyUI models" "$home/comfy/ComfyUI/models" "hpc cache rm comfy KIND/FILE"
  add "ComfyUI output" "$home/comfy/ComfyUI/output" "hpc download comfy, then delete by hand"
  for e in "$home"/envs/*; do
    [ -d "$e" ] && add "environment $(basename "$e")" "$e" "rm -rf ~/envs/$(basename "$e")  (hpc setup rebuilds it)"
  done
  add "ollama models" "$home/.ollama" "hpc cache rm ollama NAME"
  # Hub entries, shared Xet blob store, and the Xet chunk cache are separate; one folder total misled rm hf.
  add "Hugging Face hub" "$home/.cache/huggingface/hub" "hpc cache rm hf ORG/NAME"
  add "Hugging Face blobs" "$home/.cache/huggingface/blobs" "hf cache prune  (unreferenced shared blobs)"
  add "Hugging Face xet" "$home/.cache/huggingface/xet" "rm -rf ~/.cache/huggingface/xet"
  add "pip cache" "$home/.cache/pip" "hpc cache clean"
  add "uv cache" "$home/.cache/uv" "hpc cache clean"
  add "conda packages" "$home/.conda/pkgs" "hpc cache clean"
  sort -t'|' -k1,1nr "$tmp" | while IFS='|' read -r kb label hint; do
    printf '%8s  %-22s %s\n' "$(human "$kb")" "$label" "$hint"
  done
  rm -f "$tmp"
  if [ -d "$home/comfy/ComfyUI/models" ]; then
    echo; echo "largest ComfyUI model files (hpc cache rm comfy KIND/FILE):"
    # Skip placeholder stubs (put_*_here and the like): only files of at least 1 MiB.
    find "$home/comfy/ComfyUI/models" -type f -size +1M -exec du -k {} + 2>/dev/null | sort -rn | head -n 10 | while read -r kb path; do
      printf '%8s  %s\n' "$(human "$kb")" "${path#"$home/comfy/ComfyUI/models/"}"
    done
  fi
  if ls -d "$home"/.cache/huggingface/hub/models--* >/dev/null 2>&1; then
    echo; echo "Hugging Face models (hpc cache rm hf ORG/NAME):"
    for e in "$home"/.cache/huggingface/hub/models--*; do
      printf '%8s  %s\n' "$(human "$(size_kb "$e")")" "$(basename "$e" | sed 's/^models--//; s/--/\//g')"
    done
  fi
}

cache_clean() {
  local d kb total=0
  for d in "$home/.cache/pip" "$home/.cache/uv" "$home/.conda/pkgs"; do
    kb=$(size_kb "$d"); [ -n "$kb" ] || continue
    total=$((total + kb))
    if [ "$yes" = yes ]; then rm -rf "$d"/* "$d"/.[!.]* 2>/dev/null; echo "removed $(human "$kb") from $d"
    else echo "would remove $(human "$kb") from $d"; fi
  done
  if [ "$yes" = yes ]; then echo "freed $(human "$total")"
  else echo "dry run, nothing removed: $(human "$total") would be freed; run again with --yes"; fi
}

# A path (file or folder) to delete: dry run says what and how much; --yes deletes. A job that uses it will fail.
remove_path() { # remove_path PATH LABEL
  local kb; kb=$(size_kb "$1")
  if [ "$yes" = yes ]; then rm -rf "$1" && echo "removed $2 ($(human "$kb"))"
  else echo "would remove $2 ($(human "$kb")); a job using it would fail. Dry run, nothing removed: run again with --yes"; fi
}

cache_rm() {
  local kind=$1 name=$2 path bin port pid i status=0 full line
  # if/elif and not case: bash 3.2 (the macOS one, which runs the tests) cannot parse a case inside $(...).
  if [ "$kind" = comfy ]; then
    path="$home/comfy/ComfyUI/models/$name"; [ -f "$path" ] || fail "$name is not a file in the ComfyUI models folder"
    remove_path "$path" "ComfyUI model $name"
  elif [ "$kind" = hf ]; then
    path="$home/.cache/huggingface/hub/models--${name//\//--}"; [ -d "$path" ] || fail "$name is not in the Hugging Face cache"
    # Prefer the Hub CLI: it prunes unreferenced hub/shared blobs. Without it, only the hub folder goes.
    if command -v hf >/dev/null 2>&1; then
      if [ "$yes" = yes ]; then
        hf cache rm "model/$name" --yes && echo "removed Hugging Face model $name (via hf cache rm)" || fail "hf cache rm failed for $name"
      else
        hf cache rm "model/$name" --dry-run
        echo "Dry run, nothing removed: run again with --yes"
      fi
    else
      kb=$(size_kb "$path")
      if [ "$yes" = yes ]; then
        rm -rf "$path" && echo "removed Hugging Face model $name ($(human "$kb")); warning: hf not on PATH, shared blobs/xet may remain"
      else
        echo "would remove Hugging Face model $name ($(human "$kb")); hf not on PATH, so only the hub folder would be deleted and shared blobs/xet may remain. Dry run, nothing removed: run again with --yes"
      fi
    fi
  else
    bin=$home/.local/bin/ollama full=$name port=$((20000 + RANDOM % 20000))
    [[ $full == *:* ]] || full=$full:latest
    [ -x "$bin" ] || fail "ollama is not installed: run hpc setup ollama"
    # The client talks to a server: start a private one on this node, for the time of the command.
    export OLLAMA_HOST=127.0.0.1:$port
    "$bin" serve >/dev/null 2>&1 &
    pid=$!
    for i in $(seq 30); do curl -fs "http://$OLLAMA_HOST/" >/dev/null 2>&1 && break; sleep 1; done
    curl -fs "http://$OLLAMA_HOST/" >/dev/null 2>&1 || { kill "$pid" 2>/dev/null; fail "the ollama server did not start"; }
    line=$("$bin" list | awk -v n="$full" 'NR > 1 && $1 == n {print $3 " " $4}')
    if [ -z "$line" ]; then echo "FAIL - $full is not installed"; status=1
    elif [ "$yes" = yes ]; then "$bin" rm "$full" && echo "removed ollama model $full ($line)" || status=1
    else echo "would remove ollama model $full ($line); a job using it would fail. Dry run, nothing removed: run again with --yes"; fi
    kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
    exit $status
  fi
}

"cache_$action" "$@"
EOF
)

# Space used in the home, and deletion of what can be recreated or what the user names. Deleting is a dry run
# unless --yes is given. The environments in ~/envs are never deleted from here.
cmd_cache() {
  local action=report time=01:00:00 yes=no pos=()
  case ${1:-} in clean|rm|report) action=$1; shift ;; esac
  while [[ $# -gt 0 ]]; do
    case $1 in
      --time) time=${2:?--time needs a value}; shift 2 ;;
      --yes)  yes=yes; shift ;;
      -*)     die "unknown option $1" ;;
      *)      pos+=("$1"); shift ;;
    esac
  done
  [[ $yes == no || $action != report ]] || die "--yes applies to clean and rm only"
  case $action in
    report|clean) [[ ${#pos[@]} -eq 0 ]] || die "usage: hpc cache [report|clean] [--yes] [--time T]" ;;
    rm)
      [[ ${#pos[@]} -eq 2 ]] || die "usage: hpc cache rm comfy KIND/FILE | ollama NAME | hf ORG/NAME [--yes] [--time T]"
      case ${pos[0]} in
        comfy)  [[ ${pos[1]} =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)+$ ]] || die "invalid ComfyUI model '${pos[1]}': a file inside a models folder (KIND/FILE), without spaces or '..'" ;;
        ollama) [[ ${pos[1]} =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*$ ]] || die "invalid Ollama model name '${pos[1]}'" ;;
        hf)     [[ ${pos[1]} =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*/[A-Za-z0-9_][A-Za-z0-9._-]*$ ]] || die "invalid Hugging Face model '${pos[1]}': ORG/NAME" ;;
        *)      die "rm takes comfy, ollama or hf" ;;
      esac ;;
  esac
  cpu_node_run "$time" "$CACHE_SCRIPT" hpc-cache "$action" "$yes" ${pos[@]+"${pos[@]}"}
}

# Fetch results from the cluster. For comfy: the ComfyUI output folder, everything new (rsync skips what is
# already there and never deletes), some files by PATH (relative to that folder), or the N most recent.
cmd_download() {
  [[ ${1:-} == comfy ]] || die "usage: hpc download comfy [--to DIR] [--latest N] [PATH...]"
  shift
  local dest=comfy-output latest='' files=() p listed sources=() src=comfy/ComfyUI/output
  while [[ $# -gt 0 ]]; do
    case $1 in
      --to)     dest=${2:?--to needs a value}; shift 2 ;;
      --latest) latest=${2:?--latest needs a value}; shift 2 ;;
      -*)       die "unknown option $1" ;;
      *)        files+=("$1"); shift ;;
    esac
  done
  [[ -z $latest || $latest =~ ^[1-9][0-9]*$ ]] || die "--latest needs a number greater than 0"
  [[ -z $latest || ${#files[@]} -eq 0 ]] || die "--latest and PATH exclude each other"
  if [[ -n $latest ]]; then
    listed=$(on_cluster "cd $src && find . -type f ! -name '.*' ! -name '_output_*' -printf '%T@ %P\\n' | sort -rn | head -n $latest | cut -d' ' -f2-")
    [[ -n $listed ]] || die "no output files on the cluster"
    while IFS= read -r p; do files+=("$p"); done <<< "$listed"
  fi
  # Paths inside the output folder, with no space (the remote shell would split it) and no ".." (no segment starts with a dot).
  for p in ${files[@]+"${files[@]}"}; do
    [[ $p =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$ ]] || die "invalid path '$p': a file or folder inside the output folder, without spaces"
  done
  mkdir -p "$dest"
  if [[ ${#files[@]} -eq 0 ]]; then
    rsync -aP -e "ssh ${SHARED[*]}" --exclude _output_images_will_be_put_here "$TARGET:$src/" "$dest/"
  else
    for p in "${files[@]}"; do sources+=("$TARGET:$src/./$p"); done
    rsync -aPR -e "ssh ${SHARED[*]}" "${sources[@]}" "$dest/"
  fi
}

# Run a bash script (given as text) on a cpu node, with the arguments ARGS; $0 of the script is NAME.
# Downloads and pip run on a compute node, not on the head node.
cpu_node_run() { # cpu_node_run TIME SCRIPT NAME [ARGS...]
  local time=$1 script=$2
  shift 2
  resources cpu --time "$time"
  remote_login "srun $(quote_args "${ARGS[@]}" bash -c "$script" "$@")"
}

# What `hpc model` runs on the compute node: "comfy URL DIR NAME" or "ollama NAME". It never overwrites a
# model and refuses when the home has too little free space.
MODEL_SCRIPT=$(cat <<'EOF'
set -u -o pipefail
fail() { echo "FAIL - $1"; return 1; }
free_bytes() { df -Pk "$HOME" | awk 'NR==2 {print $4 * 1024}'; }
gb() { awk -v b="$1" 'BEGIN {printf "%.1f GB", b / 1073741824}'; }

# Size announced by the last response of URL (after the redirects); empty when the server does not give it.
announced_size() {
  curl -fsIL --max-time 30 "$1" | tr -d '\r' | awk '/^HTTP/ {s = ""} tolower($1) == "content-length:" {s = $2} END {print s}'
}

# Arguments: URL DIR NAME, repeated. The space is checked on the sum before anything is downloaded; after that
# every file is tried, and the status is non-zero when one failed.
model_comfy() {
  local ws=$HOME/comfy/ComfyUI free total=0 status=0 i n=0 target
  local url=() dir=() name=() size=() action=()
  [ -d "$ws" ] || { fail "ComfyUI is not installed in $ws: run hpc setup comfy"; return 1; }
  while [ $# -ge 3 ]; do url[n]=$1; dir[n]=$2; name[n]=$3; shift 3; n=$((n + 1)); done
  free=$(free_bytes)
  for ((i = 0; i < n; i++)); do
    target=$ws/models/${dir[i]}/${name[i]}
    size[i]=$(announced_size "${url[i]}")
    if [ -e "$target" ]; then
      if [ -n "${size[i]}" ] && [ "$(wc -c < "$target" | tr -d ' ')" = "${size[i]}" ]; then action[i]=have; else action[i]=differs; fi
    else
      action[i]=get
      total=$((total + ${size[i]:-0}))
      [ -n "${size[i]}" ] || echo "warn - ${name[i]}: the server does not announce the size, so it is not in the space check"
    fi
  done
  if [ "$total" -gt "$free" ]; then fail "not enough space: the downloads need $(gb "$total"), the home has $(gb "$free") free"; return 1; fi
  echo "free space in the home: $(gb "$free"); to download: $(gb "$total")"
  unset VIRTUAL_ENV
  export CONDA_PREFIX="$HOME/envs/comfy" PYTHONNOUSERSITE=1
  for ((i = 0; i < n; i++)); do
    target=$ws/models/${dir[i]}/${name[i]}
    if [ "${action[i]}" = have ]; then echo "ok   - ${name[i]} is already in models/${dir[i]}"
    elif [ "${action[i]}" = differs ]; then fail "$target exists with a different size: remove it and run again"; status=1
    else
      mkdir -p "$ws/models/${dir[i]}"
      if "$HOME/envs/comfy/bin/comfy-cli" --skip-prompt --workspace "$ws" model download --url "${url[i]}" --relative-path "models/${dir[i]}" --filename "${name[i]}" && [ -f "$target" ]
      then echo "ok   - ${name[i]} is in models/${dir[i]}"; else fail "download of ${name[i]} failed"; status=1; fi
    fi
  done
  return $status
}

model_ollama() {
  local bin=$HOME/.local/bin/ollama full=$1 port=$((20000 + RANDOM % 20000)) pid i status=1
  [[ $full == *:* ]] || full=$full:latest
  [ -x "$bin" ] || { fail "ollama is not installed: run hpc setup ollama"; return 1; }
  echo "free space in the home: $(gb "$(free_bytes)")"
  # The client talks to a server: start a private one on this node, for the time of the pull.
  export OLLAMA_HOST=127.0.0.1:$port
  "$bin" serve >/dev/null 2>&1 &
  pid=$!
  for i in $(seq 30); do curl -fs "http://$OLLAMA_HOST/" >/dev/null 2>&1 && break; sleep 1; done
  if ! curl -fs "http://$OLLAMA_HOST/" >/dev/null 2>&1; then fail "the ollama server did not start"
  elif "$bin" list | awk 'NR > 1 {print $1}' | grep -qxF "$full"; then echo "ok   - $full is already installed"; status=0
  elif "$bin" pull "$full"; then echo "ok   - $full pulled"; status=0
  else fail "pull of $full failed"; fi
  kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
  return $status
}

kind=$1; shift
"model_$kind" "$@"
EOF
)

# List the ComfyUI models of the ComfyUI-Manager catalogue and the Ollama models installed, marking those
# present. Reads files only, so it runs on the head node; the script is remote/model_list.py.
cmd_model_list() {
  local target=all type='' text='' urls=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      comfy|ollama) target=$1; shift ;;
      --type)       type=${2:?--type needs a value}; shift 2 ;;
      --filter)     text=${2:?--filter needs a value}; shift 2 ;;
      --urls)       urls=1; shift ;;
      *)            die "usage: hpc model list [comfy|ollama] [--type TYPE] [--filter TEXT] [--urls]" ;;
    esac
  done
  [[ -z $type || $target != ollama ]] || die "--type applies to the ComfyUI catalogue only"
  # The environment of hpc setup has the catalogue; without it the script says so (and still lists Ollama).
  on_cluster "py=\$HOME/envs/comfy/bin/python; [ -x \"\$py\" ] || py=python3; PYTHONNOUSERSITE=1 \"\$py\" - $(quote_args "$target" "$type" "$text" "$urls")" < "$ROOT/remote/model_list.py"
}

# The models that a ComfyUI workflow declares ("URL<TAB>DIRECTORY<TAB>NAME" per line) or the templates that
# declare models. Runs remote/workflow_models.py on the head node; the script travels as the -c argument, so
# that standard input is free for a workflow file.
workflow_models() { # workflow_models MODE ARG...
  on_cluster "py=\$HOME/envs/comfy/bin/python; [ -x \"\$py\" ] || py=python3; PYTHONNOUSERSITE=1 \"\$py\" -c $(quote_args "$(cat "$ROOT/remote/workflow_models.py")" "$@")"
}

# Validate "URL DIR NAME" triplets and download them in one cpu job.
download_comfy() { # download_comfy TIME URL DIR NAME ...
  local time=$1 i
  shift
  local a=("$@")
  for ((i = 0; i < ${#a[@]}; i += 3)); do
    [[ ${a[i]} =~ ^https://[^[:space:]]+$ ]] || die "the URL must start with https://: ${a[i]}"
    # A folder under models/, possibly with sub-folders (diffusion_models/FLUX1); no segment may start with "."
    [[ ${a[i+1]} =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$ ]] || die "invalid --to '${a[i+1]}': a folder under models/ (loras, vae, diffusion_models/FLUX1, ...), see: hpc model list"
    [[ ${a[i+2]} =~ ^[A-Za-z0-9._-]+$ ]] || die "cannot derive a safe file name from ${a[i]}: use --filename"
  done
  cpu_node_run "$time" "$MODEL_SCRIPT" hpc-model comfy "${a[@]}"
}

# Download the models listed by workflow_models (TSV lines in $2).
download_declared() { # download_declared TIME TSV
  local args=() url dir name
  while IFS=$'\t' read -r url dir name; do
    if [[ -n $url ]]; then args+=("$url" "$dir" "$name"); fi
  done <<< "$2"
  [[ ${#args[@]} -gt 0 ]] || die "the workflow declares no models"
  download_comfy "$1" "${args[@]}"
}

# The models of a ComfyUI template, by name, or the list of the templates and how many models are present.
cmd_model_template() {
  local time=01:00:00 name='' text='' list=0 declared
  if [[ ${1:-} == list ]]; then list=1; shift; fi
  while [[ $# -gt 0 ]]; do
    case $1 in
      --time)   time=${2:?--time needs a value}; shift 2 ;;
      --filter) text=${2:?--filter needs a value}; shift 2 ;;
      -*)       die "unknown option $1" ;;
      *)        [[ -z $name ]] || die "name exactly one template"; name=$1; shift ;;
    esac
  done
  if [[ $list -eq 1 ]]; then
    [[ -z $name ]] || die "usage: hpc model template list [--filter TEXT]"
    workflow_models list "$text" < /dev/null
    return
  fi
  [[ $name =~ ^[A-Za-z0-9_.-]+$ ]] || die "usage: hpc model template NAME [--time T] | hpc model template list [--filter TEXT]"
  [[ -z $text ]] || die "--filter applies to 'template list'"
  declared=$(workflow_models models template "$name" < /dev/null)
  download_declared "$time" "$declared"
}

# Download models on the cluster: ComfyUI files by URL (or those a workflow file declares) into models/KIND,
# or an Ollama model by name. For ComfyUI, a --to applies to the URLs that follow it; a URL before any --to
# takes the first --to.
cmd_model() {
  local time=01:00:00 kind=${1:-} first_to='' cur_to='' filename='' workflow='' pos=() tos=() i name args=()
  if [[ $kind == list ]]; then shift; cmd_model_list "$@"; return; fi
  if [[ $kind == template ]]; then shift; cmd_model_template "$@"; return; fi
  [[ $kind == comfy || $kind == ollama ]] || die "usage: hpc model comfy [--to KIND] URL... [--to KIND URL...] [--filename NAME] [--time T] | hpc model comfy --workflow FILE | hpc model template NAME | hpc model ollama NAME [--time T] | hpc model list [comfy|ollama]"
  shift
  while [[ $# -gt 0 ]]; do
    case $1 in
      --time)     time=${2:?--time needs a value}; shift 2 ;;
      --to)       cur_to=${2:?--to needs a value}; first_to=${first_to:-$cur_to}; shift 2 ;;
      --filename) filename=${2:?--filename needs a value}; shift 2 ;;
      --workflow) workflow=${2:?--workflow needs a value}; shift 2 ;;
      -*)         die "unknown option $1" ;;
      *)          pos+=("$1"); tos+=("$cur_to"); shift ;;
    esac
  done
  if [[ $kind == ollama ]]; then
    [[ ${#pos[@]} -eq 1 ]] || die "name exactly one Ollama model"
    [[ -z $first_to && -z $filename && -z $workflow ]] || die "--to, --filename and --workflow apply to comfy only"
    [[ ${pos[0]} =~ ^[A-Za-z0-9._:/-]+$ ]] || die "invalid Ollama model name '${pos[0]}'"
    cpu_node_run "$time" "$MODEL_SCRIPT" hpc-model ollama "${pos[0]}"
  elif [[ -n $workflow ]]; then
    [[ ${#pos[@]} -eq 0 && -z $first_to && -z $filename ]] || die "--workflow replaces the URLs, --to and --filename"
    [[ -r $workflow ]] || die "cannot read the workflow file '$workflow'"
    download_declared "$time" "$(workflow_models models stdin - < "$workflow")"
  else
    [[ ${#pos[@]} -ge 1 ]] || die "name at least one URL, or use --workflow FILE or hpc model template NAME"
    [[ -n $first_to ]] || die "--to needs the models folder (loras, vae, diffusion_models/FLUX1, ...), see: hpc model list"
    [[ -z $filename || ${#pos[@]} -eq 1 ]] || die "--filename applies to a single URL"
    for i in "${!pos[@]}"; do
      name=${filename:-$(basename "${pos[i]%%\?*}")}
      args+=("${pos[i]}" "${tos[i]:-$first_to}" "$name")
    done
    download_comfy "$time" "${args[@]}"
  fi
}

# Start a server as a job, wait for its node, expose it on localhost:PORT; Ctrl-C (or a dropped
# tunnel) cancels the job.
cmd_serve() {
  [[ $# -ge 1 ]] || die "usage: hpc serve CLASS --time HH:MM:SS (jupyter|comfy|ollama|vllm MODEL|tensorboard [LOGDIR]|openwebui [URL]|llamacpp MODEL|mlflow [STORE] | --cmd COMMAND --port PORT) [--port PORT] [--args OPTIONS] [--booked] [--push] [--free] [--cpus N] [--mem SIZE] [-- SBATCH_OPTION...]"
  local class=$1 args=() port='' cmd='' name extra=''
  shift
  while [[ $# -gt 0 ]]; do
    case $1 in
      --port) port=${2:?--port needs a value}; shift 2 ;;
      --cmd)  cmd=${2:?--cmd needs a value}; shift 2 ;;
      --args) extra=${2:?--args needs a value}; shift 2 ;;
      --)     args+=("$@"); break ;;
      *)      args+=("$1"); shift ;;
    esac
  done
  resources "$class" ${args[@]+"${args[@]}"}
  [[ $REQUEUE -eq 0 ]] || die "--requeue does not apply to a served process"
  if [[ -n $cmd ]]; then
    [[ ${#REST[@]} -eq 0 ]] || die "give either a service or --cmd, not both"
    [[ -n $port ]] || die "--cmd needs --port"
    [[ -z $extra ]] || die "--args does not apply to --cmd: write the whole command"
    name=custom SERVICE=$cmd
  else
    [[ ${#REST[@]} -ge 1 ]] || die "name one service (jupyter|comfy|ollama|vllm|tensorboard|openwebui|llamacpp|mlflow) or use --cmd"
    name=${REST[0]}
    case $name in
      vllm|llamacpp|tensorboard|openwebui|mlflow) [[ ${#REST[@]} -le 2 ]] || die "$name takes one argument" ;;
      *)                                          [[ ${#REST[@]} -eq 1 ]] || die "$name takes no argument" ;;
    esac
    service "$name" "${REST[1]:-}"
    if [[ -n $extra ]]; then
      case $name in
        vllm|tensorboard|openwebui|llamacpp|mlflow) SERVICE="$SERVICE $extra" ;;
        *) die "--args applies to vllm, tensorboard, openwebui, llamacpp and mlflow only" ;;
      esac
    fi
    port=${port:-$PORT}
  fi
  [[ $port =~ ^[0-9]+$ ]] || die "--port needs a number"
  if [[ $PUSH -eq 1 ]]; then cmd_push; fi

  # A serve killed with SIGKILL, or a crashed machine, leaves its job running until --time ends: say so.
  # Only a warning, since several services can legitimately run together (job name serve-<service>).
  local jid jname active
  active=$(remote 'squeue -h -u "$USER" -o "%i %j"') || die "cannot list your jobs"
  while read -r jid jname; do
    if [[ ${jname:-} == serve-* ]]; then
      echo "hpc: warning: job $jid ($jname) of yours is still active; if it is a leftover: hpc cancel $jid" >&2
    fi
  done <<<"$active"

  local out id
  out=$(remote_login "cd $(printf %q "$REMOTE_DIR") && sbatch --parsable $(quote_args "${ARGS[@]}" --job-name="serve-$name" ${EXTRA[@]+"${EXTRA[@]}"} --wrap="$PICK_PORT${SERVICE//__PORT__/\$HPC_RPORT}")")
  id=${out%%;*}
  [[ $id =~ $JOB_ID ]] || die "cannot read the job ID from the sbatch output"
  # Double quotes: $id is local to this function and must be expanded before the trap runs at exit.
  trap "trap - EXIT; remote 'scancel $id' >/dev/null || true; echo 'hpc: job $id cancelled'" EXIT
  trap 'exit 130' INT TERM

  local state node last=''
  while :; do
    out=$(remote "squeue -h -j $id -o '%T %N'") || die "cannot query job $id"
    read -r state node <<<"$out" || true
    [[ -n $state ]] || die "job $id ended before it started (see: hpc logs $id)"
    [[ $state == RUNNING && -n ${node:-} ]] && break
    [[ $state == "$last" ]] || echo "hpc: job $id $state"
    last=$state
    sleep 5
  done
  # The job picks a free port on the node and announces it in its log (see PICK_PORT). A server such as vLLM
  # then opens that port only after minutes of loading, so wait for it (a TCP connection from the head node,
  # which is what the tunnel goes through) and give up if the job leaves RUNNING.
  echo "hpc: job $id runs on $node; waiting for the server (hpc logs $id)"
  local node_port=''
  while :; do
    [[ -n $node_port ]] || node_port=$(remote "cd $(printf %q "$REMOTE_DIR") && sed -n 's/^HPC_PORT=//p' slurm-$id.out" 2>/dev/null || true)
    [[ $node_port =~ ^[0-9]+$ ]] || node_port=''
    [[ -z $node_port ]] || ! remote "timeout 3 bash -c 'exec 3<>/dev/tcp/$node/$node_port'" >/dev/null 2>&1 || break
    state=$(remote "squeue -h -j $id -o %T") || die "cannot query job $id"
    [[ $state == RUNNING ]] || die "job $id ${state:-ended} before the server was ready (see: hpc logs $id)"
    sleep 5
  done
  echo "hpc: ready on port $node_port of the node, open http://localhost:$port"
  open_tunnel "$node" "$port" "$node_port"
}

# What `hpc bench` runs on the compute node (bash -c, with MODEL, the options of vllm serve, those of vllm bench
# serve and the port picked by the job as arguments): start vLLM on the loopback, wait for its port, run the
# benchmark that vLLM ships at two concurrency levels (one stream, then 16), stop the server. The server log
# goes to its own file so that the job log holds only the results; --ignore-eos makes every answer reach the
# requested length, otherwise random prompts end early and distort the tokens per second.
BENCH_SCRIPT=$(cat <<'EOF'
set -u
model=$1 serve_args=$2 bench_args=$3 port=$4
unset VIRTUAL_ENV
export PYTHONNOUSERSITE=1 PATH="$HOME/envs/vllm/bin:$PATH"
log=bench-server-${SLURM_JOB_ID:-local}.log
vllm serve "$model" --host 127.0.0.1 --port "$port" $serve_args > "$log" 2>&1 &
server=$!
until (exec 3<>/dev/tcp/127.0.0.1/"$port") 2>/dev/null; do
  kill -0 "$server" 2>/dev/null || { echo "hpc-bench: the server died, last lines of $log:"; tail -n 20 "$log"; exit 1; }
  sleep 5
done
status=0
for c in 1 16; do
  echo "== hpc-bench: $model, concurrency $c"
  vllm bench serve --backend openai --base-url "http://127.0.0.1:$port" --endpoint /v1/completions --model "$model" \
    --dataset-name random --random-input-len 512 --random-output-len 128 --ignore-eos --num-prompts 100 \
    --max-concurrency "$c" --disable-tqdm $bench_args || status=1
done
kill "$server" 2>/dev/null
wait "$server" 2>/dev/null
exit $status
EOF
)

# Benchmark a model on a GPU class: one job runs BENCH_SCRIPT, then the results are printed here.
cmd_bench() {
  [[ $# -ge 1 ]] || die "usage: hpc bench CLASS --time HH:MM:SS MODEL [--args OPTIONS] [--bench-args OPTIONS] [--booked] [--push] [--free] [--cpus N] [--mem SIZE] [-- SBATCH_OPTION...]"
  local class=$1 args=() serve_args='' bench_args=''
  shift
  while [[ $# -gt 0 ]]; do
    case $1 in
      --args)       serve_args=${2:?--args needs a value}; shift 2 ;;
      --bench-args) bench_args=${2:?--bench-args needs a value}; shift 2 ;;
      --)           args+=("$@"); break ;;
      *)            args+=("$1"); shift ;;
    esac
  done
  resources "$class" ${args[@]+"${args[@]}"}
  [[ -n $PROFILE ]] || die "bench needs a GPU class (tiny, small, medium or large)"
  [[ $REQUEUE -eq 0 ]] || die "--requeue does not apply to a benchmark"
  [[ ${#REST[@]} -eq 1 ]] || die "name one model: hpc bench CLASS --time T MODEL"
  if [[ $PUSH -eq 1 ]]; then cmd_push; fi

  local out id
  out=$(remote_login "cd $(printf %q "$REMOTE_DIR") && sbatch --parsable $(quote_args "${ARGS[@]}" --job-name=bench-vllm ${EXTRA[@]+"${EXTRA[@]}"} --wrap="$PICK_PORT bash -c $(printf %q "$BENCH_SCRIPT") hpc-bench $(printf %q "${REST[0]}") $(printf %q "$serve_args") $(printf %q "$bench_args") \"\$HPC_RPORT\"")")
  id=${out%%;*}
  [[ $id =~ $JOB_ID ]] || die "cannot read the job ID from the sbatch output"
  echo "hpc: job $id benchmarks ${REST[0]} on class $class (hpc logs $id)"
  # Ctrl-C cancels the job; once it has ended there is nothing left to cancel.
  trap "trap - EXIT; remote 'scancel $id' >/dev/null 2>&1 || true; echo 'hpc: job $id cancelled'" EXIT
  trap 'exit 130' INT TERM
  local status=0
  cmd_wait "$id" || status=$?
  trap - EXIT INT TERM
  [[ $status -eq 0 ]] || die "job $id did not complete (see: hpc logs $id)"
  # Only the headline of each run and vLLM's result table: the rest of the log is warnings and a dump of the options.
  remote "cd $(printf %q "$REMOTE_DIR") && awk '/^== hpc-bench/{print} /Serving Benchmark Result/{p=1} p{print} /^=+\$/{p=0}' slurm-$id.out"
}

# Tell when a job ends, for a job already started too: a detached `hpc wait` (macOS notification, Mac and VPN on),
# and with --mail Slurm's own mail (MailType END and FAIL set on the job with scontrol).
cmd_notify() {
  local id='' mail='' want_mail=0 state
  while [[ $# -gt 0 ]]; do
    case $1 in
      --mail) want_mail=1; if [[ ${2:-} == *@* ]]; then mail=$2; shift; fi; shift ;;
      -*)     die "unknown option $1" ;;
      *)      [[ -z $id ]] || die "usage: hpc notify JOB_ID [--mail [ADDRESS]]"; id=$1; shift ;;
    esac
  done
  [[ $id =~ $JOB_ID ]] || die "usage: hpc notify JOB_ID [--mail [ADDRESS]]"
  if [[ $want_mail -eq 1 ]]; then
    mail=${mail:-${HPC_MAIL:-}}
    [[ -n $mail ]] || die "--mail needs an address: pass it or set HPC_MAIL"
    [[ $mail =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$ ]] || die "invalid mail address '$mail'"
  fi
  # squeue knows a job the moment it is submitted; sacct, the accounting, can lag behind and does not know it yet.
  state=$(remote "s=\$(squeue -h -j $id -o %T | head -n 1); [ -n \"\$s\" ] || s=\$(sacct -X -n -P -j $id --format=State | head -n 1); echo \"\$s\"")
  [[ -n $state ]] || die "job $id not found"
  [[ $state =~ ^(PENDING|RUNNING|REQUEUED|SUSPENDED|COMPLETING|RESIZING)$ ]] || die "job $id has already ended ($state)"
  if [[ $want_mail -eq 1 ]]; then
    remote "scontrol update JobId=$id MailType=END,FAIL MailUser=$mail" || die "cannot set the mail on job $id"
    echo "hpc: Slurm will mail $mail when job $id ends or fails"
  fi
  # HUP ignored, so that closing the terminal does not stop the watch.
  (trap '' HUP; cmd_wait "$id") </dev/null >/dev/null 2>&1 &
  echo "hpc: watching job $id ($state) in the background (process $!, stop it with kill $!); a notification tells when it ends"
  disown
}

# Block until the job (or every task of a job array) ends; succeed only if all of it COMPLETED.
# One SSH session: the loop runs on the head node.
cmd_wait() {
  [[ ${1:-} =~ $JOB_ID ]] || die "usage: hpc wait JOB_ID"
  local query="sacct -X -n -P -j $1 --format=JobID,State,Elapsed,ExitCode"
  local active='\|(PENDING|RUNNING|REQUEUED|SUSPENDED|COMPLETING|RESIZING)\|' status=0 word=completed
  TTY=1 remote "s=\$($query); [ -n \"\$s\" ] || { echo \"hpc: job $1 not found\" >&2; exit 1; }
while echo \"\$s\" | grep -qE \"$active\"; do sleep 10; s=\$($query); done
echo \"\$s\"; ! echo \"\$s\" | grep -qv \"|COMPLETED|\"" || status=$?
  [[ $status -eq 0 ]] || word="did not complete"
  # Desktop notification where macOS provides one, so a long job can be left running unattended.
  if command -v osascript >/dev/null; then osascript -e "display notification \"job $1 $word\" with title \"hpc\""; fi
  return $status
}

# Check, step by step, what the other commands need; the cluster checks are skipped when it is unreachable.
cmd_doctor() {
  local failed=0 tool
  check() { # check LABEL HINT COMMAND...
    local label=$1 hint=$2
    shift 2
    if "$@" >/dev/null 2>&1; then echo "ok   - $label"; else echo "FAIL - $label: $hint"; failed=1; return 1; fi
  }
  for tool in ssh rsync; do
    check "$tool is installed" "install $tool" command -v "$tool" || true
  done
  check "uv is installed" "needed by 'hpc top' only: https://docs.astral.sh/uv/" command -v uv || true
  if check "$TARGET answers with your SSH key" "connect the university VPN, then check the key with: ssh $TARGET" \
       ssh -o BatchMode=yes -o ConnectTimeout=10 "$TARGET" true; then
    check "Slurm is available on the head node" "run: ssh $TARGET 'bash -lc \"module load slurm\"' and report the error" \
      remote "sbatch --version" || true
    check "the project directory ~/$REMOTE_DIR exists" "run 'hpc push' from this directory" \
      ssh "$TARGET" "test -d $(printf %q "$REMOTE_DIR")" || true
  fi
  return $failed
}

cmd_cancel() {
  [[ ${1:-} =~ $JOB_ID ]] || die "usage: hpc cancel JOB_ID"
  remote "scancel $1"
}

usage() {
  cat <<'EOF'
usage: hpc COMMAND [ARGS]
  submit CLASS --time T [--booked] [--requeue] [--push] [--free] [--cpus N] [--mem SIZE] SCRIPT [-- SBATCH_OPTION...]
                  submit SCRIPT from ~/projects/<current dir name>; CLASS: tiny|small|medium|large|cpu;
                  options after -- go to sbatch as they are (e.g. -- --array=1-50); --push syncs first;
                  --free fails at once unless a GPU slice of CLASS is free now (needs uv)
  run CLASS --time T [--booked] [--requeue] [--free] [--cpus N] [--mem SIZE] [--pull PATH]... SCRIPT [-- SBATCH_OPTION...]
                  push, submit, wait for the job and pull each --pull PATH if it COMPLETED
  sweep CLASS --time T --params FILE [--parallel N] [options] SCRIPT [-- SBATCH_OPTION...]
                  job array with one task per line of FILE; a task reads its line from $HPC_SWEEP_FILE
  status          running and pending jobs and the last job of the week, in one line
  queue [-w [S]]  your jobs and the last day of job history; -w refreshes every S seconds (default 10)
  top             interactive view of the cluster and of your jobs (needs uv on this machine)
  qos             QoS associations granted to your account
  push            sync the current directory to the cluster (honours .gitignore, never deletes)
  pull PATH...    fetch files from the cluster project directory
  logs [ID] [-f]  show (or follow) the latest *.out, or the one matching job ID
  cancel ID       cancel a job
  shell CLASS --time T [--booked] [--push] [--free] [--cpus N] [--mem SIZE] [-- SRUN_OPTION...]
                  interactive shell on a compute node, started in ~/projects/<current dir name>
  tunnel ID PORT  forward localhost:PORT to the same port of the node running job ID (Ctrl-C to close)
  notify ID [--mail [ADDRESS]]
                  watch job ID in the background and show a macOS notification when it ends (a job already
                  started too); --mail also sets Slurm's mail on it (ADDRESS or HPC_MAIL)
  cache [report|clean|rm comfy KIND/FILE|ollama NAME|hf ORG/NAME] [--yes] [--time T]
                  space used in the home, by location (in a cpu job); clean removes the pip, uv and conda caches;
                  rm removes one model; deleting is a dry run unless --yes; environments are never deleted
  bench CLASS --time T MODEL [--args OPTIONS] [--bench-args OPTIONS] [options] [-- SBATCH_OPTION...]
                  benchmark vLLM on a GPU class in one job (output tokens per second, time to first token,
                  time per token, at concurrency 1 and 16); --args goes to vllm serve, --bench-args to vllm bench serve
  serve CLASS --time T (jupyter|comfy|ollama|vllm MODEL|tensorboard [LOGDIR]|openwebui [URL]|llamacpp MODEL|mlflow [STORE] | --cmd COMMAND --port PORT) [--port PORT] [--args OPTIONS] [options] [-- SBATCH_OPTION...]
                  run a server as a job, wait until it listens and open it on localhost:PORT; Ctrl-C cancels the job;
                  --args appends OPTIONS, as typed, to vllm, tensorboard, openwebui, llamacpp or mlflow;
                  PORT is the local one; the job picks a free port on the node and in --cmd __PORT__ is replaced by it;
                  the server must listen on 0.0.0.0
  setup [ollama] [comfy] [vllm] [tensorboard] [openwebui] [llamacpp] [mlflow] [--time T]
                  check ollama (~/.local), ComfyUI (~/comfy), llama-server (~/.local/bin), and the pip envs in
                  ~/envs (vLLM, TensorBoard, Open WebUI, MLflow) on a cpu node and install what is missing,
                  software only (default: ollama and comfy; --time default 01:00:00)
  model comfy [--to KIND] URL... [--to KIND URL...] [--filename NAME] [--time T] | model ollama NAME [--time T]
                  download models on the cluster, in a cpu job: ComfyUI files into ~/comfy/ComfyUI/models/KIND (a
                  --to applies to the URLs after it; a URL before any --to takes the first one) or an Ollama
                  model; never overwrites; the free space is checked on the total before anything is downloaded;
                  a failed file does not stop the others
  model comfy --workflow FILE.json
                  download the models that a ComfyUI workflow file declares (folder and URL are in the file)
  model template NAME | model template list [--filter TEXT]
                  the same for a ComfyUI template installed on the cluster, by name; the list shows how many of
                  the models of each template are present
  download comfy [--to DIR] [--latest N] [PATH...]
                  copy the results of ComfyUI (~/comfy/ComfyUI/output) to DIR (default ./comfy-output): all that
                  is new, or the PATHs given (inside that folder), or the N most recent; never deletes
  model list [comfy|ollama] [--type TYPE] [--filter TEXT] [--urls]
                  ComfyUI models of the ComfyUI-Manager catalogue and the Ollama models installed,
                  with [x] on those already present (reads the head node; no job)
  wait ID         block until job ID ends; exit 0 only if it (every task, for an array) COMPLETED
  doctor          check tools, VPN/SSH access, Slurm and the remote project directory
  info ID         CPU and memory efficiency of a finished job (seff)
  free            classes with a free GPU slice right now, per node (needs uv on this machine)
aliases: q = queue, l = logs, w = wait, c = cancel
job IDs: a task of a job array is written ID_TASK (e.g. 10211_2) in logs, cancel, wait, tunnel and info
environment: HPC_USER (required) is your cluster login
EOF
}

case ${1:-help} in
  sweep)  shift; cmd_sweep "$@" ;;
  status) cmd_status ;;
  run)    shift; cmd_run "$@" ;;
  submit) shift; cmd_submit "$@" ;;
  queue|q) shift; cmd_queue "$@" ;;
  top)    cmd_top ;;
  qos)    cmd_qos ;;
  push)   cmd_push ;;
  pull)   shift; cmd_pull "$@" ;;
  logs|l) shift; cmd_logs "$@" ;;
  cancel|c) shift; cmd_cancel "$@" ;;
  shell)  shift; cmd_shell "$@" ;;
  tunnel) shift; cmd_tunnel "$@" ;;
  serve)  shift; cmd_serve "$@" ;;
  cache)  shift; cmd_cache "$@" ;;
  bench)  shift; cmd_bench "$@" ;;
  setup)  shift; cmd_setup "$@" ;;
  model)  shift; cmd_model "$@" ;;
  download) shift; cmd_download "$@" ;;
  wait|w) shift; cmd_wait "$@" ;;
  notify) shift; cmd_notify "$@" ;;
  doctor) cmd_doctor ;;
  info)   shift; cmd_info "$@" ;;
  free)   cmd_free ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac; exit  # nothing may follow: bash reads a script while it runs, and a file edited meanwhile would be misread
