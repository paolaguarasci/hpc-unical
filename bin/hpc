#!/usr/bin/env bash
# hpc: command-line helpers for the UniCal HPC cluster, run from your own machine over SSH.
# Requires the university OpenVPN connection and HPC_USER (your cluster login).
set -euo pipefail

HOST=hpcgate.unical.it

# Load HPC_USER from <repo>/.env unless it is already set. The repo is located by
# following symlinks, so the command works from any directory once linked on PATH.
src=${BASH_SOURCE[0]}
while [[ -L $src ]]; do
  dir=$(cd "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  [[ $src == /* ]] || src=$dir/$src
done
ROOT=$(cd "$(dirname "$src")/.." && pwd)
ENV_FILE=$ROOT/.env
if [[ -z ${HPC_USER:-} && -f $ENV_FILE ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi
: "${HPC_USER:?set HPC_USER in $ENV_FILE or in the environment}"
TARGET="$HPC_USER@$HOST"
# The current local directory maps to ~/projects/<its name> on the cluster.
REMOTE_DIR="projects/$(basename "$PWD")"

die() { echo "hpc: $*" >&2; exit 1; }

# A job ID, or a task of a job array as ID_TASK.
JOB_ID='^[0-9]+(_[0-9]+)?$'

# Commands share one SSH connection, kept for 10 minutes after the last one, so that only the
# first pays for connecting.
SHARED=(-o ControlMaster=auto -o "ControlPath=~/.ssh/hpc-%C" -o ControlPersist=600
        -o ServerAliveInterval=10 -o ServerAliveCountMax=2)

# Run a command line on the head node. Set TTY=1 to allocate a terminal (needed to interrupt a
# remote `tail -f`); a terminal session gets a connection of its own, because inside the shared
# one it can freeze it, and with it every later command.
on_cluster() {
  if [[ -n ${TTY:-} ]]; then
    ssh -o ControlPath=none -t "$TARGET" "$1"
  else
    ssh "${SHARED[@]}" "$TARGET" "$1"
  fi
}

# Run a command on the head node with Slurm loaded. No login shell: it would run the user's
# profile a second time, which costs about one second per command.
remote() { on_cluster "module load slurm && $1"; }

# The same in a login shell, for what starts a job: the job inherits that environment (Conda included).
remote_login() {
  local cmd="module load slurm && $1" quote="'" escaped="'\\''"
  on_cluster "bash -lc '${cmd//$quote/$escaped}'"
}

# Quote arguments for the remote shell.
quote_args() { printf '%q ' "$@"; }

# Class presets from the cluster guide: MIG profile, default CPU cores and RAM.
preset() {
  case $1 in
    tiny)   PROFILE=1g.35gb;  CPUS=2;  MEM=32G ;;
    small)  PROFILE=2g.35gb;  CPUS=3;  MEM=64G ;;
    medium) PROFILE=4g.71gb;  CPUS=6;  MEM=128G ;;
    large)  PROFILE=7g.141gb; CPUS=11; MEM=240G ;;
    cpu)    PROFILE='';       CPUS=1;  MEM=16G ;;
    *) die "unknown class '$1' (tiny|small|medium|large|cpu)" ;;
  esac
}

# Parse CLASS and the options shared by submit and shell.
# Sets ARGS (Slurm options), REQUEUE, PUSH, REST (positional arguments) and EXTRA (options after "--").
resources() {
  local class=$1 time='' booked=0
  shift
  preset "$class"
  REQUEUE=0 PUSH=0 REST=() EXTRA=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --time)    time=${2:?--time needs a value}; shift 2 ;;
      --cpus)    CPUS=${2:?--cpus needs a value}; shift 2 ;;
      --mem)     MEM=${2:?--mem needs a value}; shift 2 ;;
      --booked)  booked=1; shift ;;
      --requeue) REQUEUE=1; shift ;;
      --push)    PUSH=1; shift ;;
      # Everything after "--" goes to Slurm as is, after the presets, so it wins over them.
      --)        shift; EXTRA=("$@"); break ;;
      -*)        die "unknown option $1" ;;
      *)         REST+=("$1"); shift ;;
    esac
  done
  [[ -n $time ]] || die "--time is required"

  local qos=scavenger
  if [[ $booked -eq 1 ]]; then
    [[ -n $PROFILE ]] || die "the cpu class has no booking"
    qos=gpu_${class}_reserved
  fi
  ARGS=(--partition=aiq --qos="$qos" --nodes=1 --ntasks=1
        --cpus-per-task="$CPUS" --mem="$MEM" --time="$time")
  if [[ -n $PROFILE ]]; then ARGS+=(--gres="gpu:$PROFILE:1"); fi
}

cmd_submit() {
  [[ $# -ge 1 ]] || die "usage: hpc submit CLASS --time HH:MM:SS [--booked] [--requeue] [--push] [--cpus N] [--mem SIZE] SCRIPT [-- SBATCH_OPTION...]"
  resources "$@"
  [[ ${#REST[@]} -ge 1 ]] || die "missing SCRIPT"
  [[ ${#REST[@]} -eq 1 ]] || die "only one script allowed"
  if [[ $REQUEUE -eq 1 ]]; then ARGS+=(--requeue); fi
  if [[ $PUSH -eq 1 ]]; then cmd_push; fi
  # ${EXTRA[@]+...}: bash 3.2 treats an empty array as unset under `set -u`.
  remote_login "cd $(printf %q "$REMOTE_DIR") && sbatch $(quote_args "${ARGS[@]}" ${EXTRA[@]+"${EXTRA[@]}"} "${REST[0]}")"
}

# Interactive shell on a compute node, with the same resources as a job of that class.
cmd_shell() {
  [[ $# -ge 1 ]] || die "usage: hpc shell CLASS --time HH:MM:SS [--booked] [--push] [--cpus N] [--mem SIZE] [-- SRUN_OPTION...]"
  resources "$@"
  [[ $REQUEUE -eq 0 ]] || die "--requeue does not apply to an interactive shell"
  [[ ${#REST[@]} -eq 0 ]] || die "shell takes no script"
  if [[ $PUSH -eq 1 ]]; then cmd_push; fi
  TTY=1 remote_login "cd $(printf %q "$REMOTE_DIR") && srun $(quote_args "${ARGS[@]}" ${EXTRA[@]+"${EXTRA[@]}"})--pty bash -l"
}

# Push, submit, wait and pull in one command; the exit status is that of the job (see wait).
# --pull PATH (repeatable) names what to fetch when the job COMPLETED.
cmd_run() {
  [[ $# -ge 1 ]] || die "usage: hpc run CLASS --time HH:MM:SS [--booked] [--requeue] [--cpus N] [--mem SIZE] [--pull PATH]... SCRIPT [-- SBATCH_OPTION...]"
  local class=$1 args=() pull=() out
  shift
  while [[ $# -gt 0 ]]; do
    case $1 in
      --pull) pull+=("${2:?--pull needs a value}"); shift 2 ;;
      --)     args+=("$@"); break ;;
      *)      args+=("$1"); shift ;;
    esac
  done
  out=$(cmd_submit "$class" --push ${args[@]+"${args[@]}"})
  echo "$out"
  [[ $out =~ Submitted\ batch\ job\ ([0-9]+) ]] || die "cannot read the job ID from the sbatch output"
  local id=${BASH_REMATCH[1]}
  cmd_wait "$id" || die "job $id did not complete (see: hpc logs $id)"
  if [[ ${#pull[@]} -gt 0 ]]; then cmd_pull "${pull[@]}"; fi
}

cmd_queue() {
  local query='squeue -u "$USER" -o "%.10i %.24j %.10T %.10M %.24q %R"; sacct -X -S now-1days --format=JobID,JobName,State,Elapsed,ExitCode'
  case ${1:-} in
    '') remote "$query" ;;
    -w)
      local seconds=${2:-10}
      [[ $seconds =~ ^[0-9]+$ ]] || die "usage: hpc queue [-w [SECONDS]]"
      # One SSH session; `watch` on the head node re-runs the query until Ctrl-C.
      TTY=1 remote "watch -n $seconds '$query'"
      ;;
    *) die "usage: hpc queue [-w [SECONDS]]" ;;
  esac
}

# Interactive view of the cluster and of your jobs: the Textual application in hpc_top/, run locally by uv.
cmd_top() {
  HPC_TARGET=$TARGET exec uv run --project "$ROOT" hpc-top
}

# Classes with a free GPU slice right now, per node; reuses the parsers of the interactive view.
cmd_free() {
  HPC_TARGET=$TARGET exec uv run --project "$ROOT" hpc-free
}

# CPU and memory efficiency of a finished job.
cmd_info() {
  [[ ${1:-} =~ $JOB_ID ]] || die "usage: hpc info JOB_ID"
  remote "seff $1"
}

cmd_qos() {
  remote 'sacctmgr -nP show assoc where user="$USER" format=Account,User,QOS,DefaultQOS'
}

cmd_push() {
  on_cluster "mkdir -p $(printf %q "$REMOTE_DIR")"
  rsync -az -e "ssh ${SHARED[*]}" --exclude .git --filter=':- .gitignore' ./ "$TARGET:$REMOTE_DIR/"
}

cmd_pull() {
  [[ $# -ge 1 ]] || die "usage: hpc pull PATH..."
  local sources=() p
  for p in "$@"; do sources+=("$TARGET:$REMOTE_DIR/./$p"); done
  rsync -azR -e "ssh ${SHARED[*]}" "${sources[@]}" ./
}

cmd_logs() {
  local id='' a
  for a in "$@"; do
    case $a in
      -f) TTY=1 ;;
      *) [[ $a =~ $JOB_ID ]] || die "usage: hpc logs [JOB_ID] [-f]"; id=$a ;;
    esac
  done
  local follow='' pattern='*.out' lookup=''
  if [[ -n ${TTY:-} ]]; then follow=-f; fi
  # Both slurm-%j.out and %x-%j.out put "-" before the ID, so "*-12.out" cannot match job 112.
  if [[ -n $id ]]; then pattern="*-$id.out"; fi
  # %j is the real job ID of an array task, which differs from ID_TASK: ask Slurm for it.
  if [[ $id == *_* ]]; then
    lookup="id=\$(sacct -X -n -P -j $id --format=JobIDRaw | head -n 1); [ -n \"\$id\" ] || { echo 'hpc: job $id not found' >&2; exit 1; }; "
    pattern='*-$id.out'
  fi
  remote "cd $(printf %q "$REMOTE_DIR") && ${lookup}f=\$(ls -t $pattern 2>/dev/null | head -n 1); [ -n \"\$f\" ] || { echo 'hpc: no log found' >&2; exit 1; }; echo \"== \$f\"; tail -n 50 $follow \"\$f\""
}

# Forward localhost:PORT to the same port of the node that runs the job, until Ctrl-C.
cmd_tunnel() {
  [[ ${1:-} =~ $JOB_ID && ${2:-} =~ ^[0-9]+$ ]] || die "usage: hpc tunnel JOB_ID PORT"
  local node
  node=$(remote "squeue -h -j $1 -o %N") || die "job $1 not found"
  [[ -n $node ]] || die "job $1 is not running on a node"
  echo "hpc: localhost:$2 -> $node:$2 (Ctrl-C to close)"
  exec ssh -N -o ExitOnForwardFailure=yes -L "$2:$node:$2" "$TARGET"
}

# Block until the job (or every task of a job array) ends; succeed only if all of it COMPLETED.
# One SSH session: the loop runs on the head node.
cmd_wait() {
  [[ ${1:-} =~ $JOB_ID ]] || die "usage: hpc wait JOB_ID"
  local query="sacct -X -n -P -j $1 --format=JobID,State,Elapsed,ExitCode"
  local active='\|(PENDING|RUNNING|REQUEUED|SUSPENDED|COMPLETING|RESIZING)\|'
  TTY=1 remote "s=\$($query); [ -n \"\$s\" ] || { echo \"hpc: job $1 not found\" >&2; exit 1; }
while echo \"\$s\" | grep -qE \"$active\"; do sleep 10; s=\$($query); done
echo \"\$s\"; ! echo \"\$s\" | grep -qv \"|COMPLETED|\""
}

# Check, step by step, what the other commands need; the cluster checks are skipped when it is unreachable.
cmd_doctor() {
  local failed=0 tool
  check() { # check LABEL HINT COMMAND...
    local label=$1 hint=$2
    shift 2
    if "$@" >/dev/null 2>&1; then echo "ok   - $label"; else echo "FAIL - $label: $hint"; failed=1; return 1; fi
  }
  for tool in ssh rsync; do
    check "$tool is installed" "install $tool" command -v "$tool" || true
  done
  check "uv is installed" "needed by 'hpc top' only: https://docs.astral.sh/uv/" command -v uv || true
  if check "$TARGET answers with your SSH key" "connect the university VPN, then check the key with: ssh $TARGET" \
       ssh -o BatchMode=yes -o ConnectTimeout=10 "$TARGET" true; then
    check "Slurm is available on the head node" "run: ssh $TARGET 'bash -lc \"module load slurm\"' and report the error" \
      remote "sbatch --version" || true
    check "the project directory ~/$REMOTE_DIR exists" "run 'hpc push' from this directory" \
      ssh "$TARGET" "test -d $(printf %q "$REMOTE_DIR")" || true
  fi
  return $failed
}

cmd_cancel() {
  [[ ${1:-} =~ $JOB_ID ]] || die "usage: hpc cancel JOB_ID"
  remote "scancel $1"
}

usage() {
  cat <<'EOF'
usage: hpc COMMAND [ARGS]
  submit CLASS --time T [--booked] [--requeue] [--push] [--cpus N] [--mem SIZE] SCRIPT [-- SBATCH_OPTION...]
                  submit SCRIPT from ~/projects/<current dir name>; CLASS: tiny|small|medium|large|cpu;
                  options after -- go to sbatch as they are (e.g. -- --array=1-50); --push syncs first
  run CLASS --time T [--booked] [--requeue] [--cpus N] [--mem SIZE] [--pull PATH]... SCRIPT [-- SBATCH_OPTION...]
                  push, submit, wait for the job and pull each --pull PATH if it COMPLETED
  queue [-w [S]]  your jobs and the last day of job history; -w refreshes every S seconds (default 10)
  top             interactive view of the cluster and of your jobs (needs uv on this machine)
  qos             QoS associations granted to your account
  push            sync the current directory to the cluster (honours .gitignore, never deletes)
  pull PATH...    fetch files from the cluster project directory
  logs [ID] [-f]  show (or follow) the latest *.out, or the one matching job ID
  cancel ID       cancel a job
  shell CLASS --time T [--booked] [--push] [--cpus N] [--mem SIZE] [-- SRUN_OPTION...]
                  interactive shell on a compute node, started in ~/projects/<current dir name>
  tunnel ID PORT  forward localhost:PORT to the same port of the node running job ID (Ctrl-C to close)
  wait ID         block until job ID ends; exit 0 only if it (every task, for an array) COMPLETED
  doctor          check tools, VPN/SSH access, Slurm and the remote project directory
  info ID         CPU and memory efficiency of a finished job (seff)
  free            classes with a free GPU slice right now, per node (needs uv on this machine)
job IDs: a task of a job array is written ID_TASK (e.g. 10211_2) in logs, cancel, wait, tunnel and info
environment: HPC_USER (required) is your cluster login
EOF
}

case ${1:-help} in
  run)    shift; cmd_run "$@" ;;
  submit) shift; cmd_submit "$@" ;;
  queue)  shift; cmd_queue "$@" ;;
  top)    cmd_top ;;
  qos)    cmd_qos ;;
  push)   cmd_push ;;
  pull)   shift; cmd_pull "$@" ;;
  logs)   shift; cmd_logs "$@" ;;
  cancel) shift; cmd_cancel "$@" ;;
  shell)  shift; cmd_shell "$@" ;;
  tunnel) shift; cmd_tunnel "$@" ;;
  wait)   shift; cmd_wait "$@" ;;
  doctor) cmd_doctor ;;
  info)   shift; cmd_info "$@" ;;
  free)   cmd_free ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
